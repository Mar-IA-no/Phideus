# Python environments and dependencies
env/
venv/
*_env/
*.egg-info/
.eggs/
dist/
build/

# Python compiled files
__pycache__/
*.pyc
*.pyo
*.pyd

# Audio files (too large for Git)
wavs/
*.wav
*.mp3
*.flac
*_wavs/
test_wavs/
wavs_sinteticos*/

# Large datasets and training data
test/
train/
*synthetic_dataset*/
*.json
data/datasets/*.json
data/training_outputs/

# Model files and checkpoints (large files)
*.pth
*.pt
*.h5
*.ckpt
*checkpoints*/
*validation*/
models/

# Generated plots and outputs
*.png
*.jpg
*.pdf
plots/
results/

# System files
.DS_Store
.vscode/
.idea/
*.log

# Temporary and development files
src/temp/
experiments/temporal/data/
experiments/temporal/*_env/
Biblioteca/
biblioteca/

# Large comparison files
data/training_outputs/comparisons/

# Exception: Keep small config files
!config/*.json
!*.md
!requirements.txt
!.gitignore
!LICENSE.md
