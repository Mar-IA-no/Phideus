# ================================
# PHIDEUS v5.0 - CLEAN .gitignore
# Solo código fuente y documentación esencial
# ================================

# === PYTHON ===
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
venv/
env/
*_env/

# === DATOS (NUNCA EN GIT) ===
*.wav
*.mp3
*.flac
*.json
*.npz
*.pt
*.pth
*.pkl
*.h5
*.bin
*.safetensors
*.ckpt

# === DIRECTORIOS DE DATOS ===
data/
train/
test/
models/
Biblioteca/
checkpoints/

# === MULTIMEDIA ===
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.svg
*.pdf
*.doc
*.docx

# === OUTPUTS Y LOGS ===
logs/
outputs/
results/
*.log
*.tmp
*~

# === SISTEMA E IDE ===
.DS_Store
Thumbs.db
.vscode/
.idea/
*.sublime-*

# === ARCHIVOS COMPRIMIDOS ===
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# === LEGACY (NO PUSHEAR) ===
Documents/Legacy/

# === NOTAS LOCALES ===
PENDIENTES.md
Documents/Claude*.md

# === EXCEPCIONES (PERMITIR) ===
!config/*.yaml
!config/*.py
!requirements*.txt
!.gitignore
!LICENSE*
